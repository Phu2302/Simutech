# Server Port
PORT=5000

# Client URL (cho cấu hình CORS)
CLIENT_URL=http://localhost:5173

# Google OAuth Client ID (Lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# JWT Secret Key dùng để ký token
JWT_SECRET=simutech_super_secret_jwt_key_2025_change_in_production

# Môi trường chạy (development / production)
NODE_ENV=development
